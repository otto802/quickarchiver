{
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "quickarchiver@bergerdata.de",
      "strict_min_version": "128.0",
      "strict_max_version": "153.*"
    }
  },
  "name": "QuickArchiver",
  "author": "Otto Berger <otto@bergerdata.de>",
  "description": "Getting things done in your inbox.",
  "version": "2.4.0",
  "default_locale": "en_US",
  "background": {
    "scripts": [
      "content/shared/rule-matching.js",
      "content/scripts/quickarchiver.js",
      "content/scripts/background.js"
    ],
    "type": "classic"
  },
  "experiment_apis": {
    "customColumns": {
      "schema": "experiments/customColumns/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "customColumns"
          ]
        ],
        "script": "experiments/customColumns/implementation.js"
      }
    }
  },
  "options_ui": {
    "page": "content/options/options.html"
  },
  "permissions": [
    "storage",
    "menus",
    "messagesRead",
    "messagesMove",
    "accountsRead"
  ],
  "commands": {
    "quickarchiver_move": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Move mail to QuickArchiver folder (if rule is present)"
    }
  },
  "message_display_action": {
    "default_title": "QuickArchiver",
    "default_icon": "content/icons/dark/qa_move.svg",
    "theme_icons": [
      {
        "dark": "content/icons/dark/qa_move.svg",
        "light": "content/icons/light/qa_move.svg",
        "size": 16
      }
    ]
  }
}
